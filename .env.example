# travelbuddy v4 — copy to .env and fill in values
# NEVER commit .env to git

# Required
OPENAI_API_KEY=sk-...

# Models
OPENAI_MODEL=gpt-4o
OPENAI_MODEL_MINI=gpt-4o-mini
OPENAI_MODEL_ROUTER=gpt-4o-mini

# Cost control — set false during development to skip web search (cheaper)
ENABLE_WEB_SEARCH=true

# Microservices (leave empty to use web search fallback)
RESCUE_AGENT_URL=
PLANNER_AGENT_URL=
ADVISORY_AGENT_URL=

# App
ENV=development
RATE_LIMIT_RPM=30
