# ── travelbuddy v4 environment variables ─────────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# ── Required ──────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── Model routing (RCG — align task complexity with model strength) ───────────
OPENAI_MODEL=gpt-4o             # advisory agent + synthesiser (complex reasoning)
OPENAI_MODEL_MINI=gpt-4o-mini   # planner, weather, activities, rescue (retrieval)
OPENAI_MODEL_ROUTER=gpt-4o-mini # clarifier, supervisor (routing/classification)

# ── Microservice URLs ─────────────────────────────────────────────────────────
# Rescue Agent MCP microservice (github.com/LEEZIYA/AIChatbotInterface/tree/rescue_agent)
# Docker internal name:  http://rescue-agent-api:8000
# Local development:     http://localhost:8001
# Disabled (web search): leave empty
RESCUE_AGENT_URL=http://localhost:8001

# Planned integrations (leave empty to use web search fallback)
PLANNER_AGENT_URL=
ADVISORY_AGENT_URL=

# ── Optional settings ─────────────────────────────────────────────────────────
ENV=development
MICROSERVICE_TIMEOUT=30
