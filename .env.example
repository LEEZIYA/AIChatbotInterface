# OpenAI API Configuration
OPENAI_API_KEY=#

# MCP Configuration
USE_MCP=true  # Enable/disable MCP servers

# Real API Keys (Optional - MCP servers use mocks by default)
FLIGHTAWARE_API_KEY=your_flightaware_key_here
OPENWEATHER_API_KEY=your_openweather_key_here

# Agent Configuration
AGENT_NAME=RescueAgent
AGENT_VERSION=2.0.0-mcp
LOG_LEVEL=INFO

# LLM Configuration
LLM_MODEL=gpt-4-turbo-preview
LLM_MAX_TOKENS=2000
LLM_TEMPERATURE=0.3

# Alternative models:
# LLM_MODEL=gpt-4o  # Latest, cheaper
# LLM_MODEL=gpt-4   # Classic
# LLM_MODEL=gpt-3.5-turbo  # Faster/cheaper

# Monitoring Configuration
POLLING_INTERVAL_CRITICAL=60  # Check every minute when close to departure
POLLING_INTERVAL_UPCOMING=1800  # Every 30 min for upcoming trips
POLLING_INTERVAL_FUTURE=21600  # Every 6 hours for future trips

# Cache Configuration
CACHE_TTL=300  # 5 minutes
CACHE_MAX_SIZE=1000

# Development
USE_MOCK_APIS=false  # Use mock flight/weather APIs (free for testing)
